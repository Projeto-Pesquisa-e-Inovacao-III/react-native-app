{
  "expo": {
    "name": "react-native-app",
    "slug": "csf",
    "scheme": "react-native-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.csf.react"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.csf.react",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para ler o QR Code da aula.",
          "barcodeScannerEnabled": true
        }
      ],
      "expo-notifications",
      "expo-status-bar",
      "./plugins/withAgp9Compatibility",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita o acesso ao microfone para gravar áudio e agendar aulas com IA.",
          "speechRecognitionPermission": "Permita o acesso ao reconhecimento de fala para transcrever sua voz.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "cmakeVersion": "3.31.6"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita o uso de biometria para acessar sua conta com rapidez e segurança."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f87e7f5-c41e-4941-a12e-08b97ae5a82e"
      }
    },
    "owner": "phillieuss-team"
  }
}
